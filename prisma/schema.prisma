generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(cuid())
  telegramId           BigInt              @unique
  username             String?
  firstName            String?
  lastName             String?
  role                 Role                @default(CANDIDATE)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  adminRole            AdminRole?
  candidate            Candidate?
  hrProfile            HRProfile?
  mentorProfile        MentorProfile?
  pendingReplies       PendingReply[]
  staffProfile         StaffProfile?
  supportTickets       SupportTicket[]     @relation("UserTickets")
  assignedTickets      SupportTicket[]     @relation("AssignedTickets")
  timelineEvents       UserTimelineEvent[]
  chatLogs             ChatLog[]
  outgoingTopics       OutgoingTopic[]
  magnetCountRuns      MagnetCountRun[]
  lastSupportMessageId Int?
  isBlocked            Boolean             @default(false)
  botBlockedAt         DateTime? // Auto-set when bot gets 403, cleared on /start
}

model Broadcast {
  id              Int                 @id @default(autoincrement())
  initiatorId     BigInt
  messageText     String?
  createdAt       DateTime            @default(now())
  completedAt     DateTime?
  cancelledAt     DateTime?
  targetSummary   String?
  trackedMessages TrackedMessage[]
  deliveries      BroadcastDelivery[]
}

model BroadcastDelivery {
  id           Int       @id @default(autoincrement())
  broadcastId  Int
  chatId       BigInt
  targetType   String
  status       String    @default("PENDING")
  attemptCount Int       @default(0)
  messageId    Int?
  lastError    String?
  startedAt    DateTime?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  broadcast    Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, chatId])
  @@index([broadcastId, status])
}

model TrackedMessage {
  id             Int            @id @default(autoincrement())
  broadcastId    Int
  chatId         BigInt
  messageId      Int
  nextPingAt     DateTime?
  /// Докуда пинговать. NULL — до ответа, как у обычных рассылок.
  pingUntil      DateTime?
  lastPingMsgId  Int?
  pingIntervalMs Int?
  pendingReplies PendingReply[]
  broadcast      Broadcast      @relation(fields: [broadcastId], references: [id])

  @@index([nextPingAt])
  @@index([pingUntil])
  @@index([broadcastId])
}

model PendingReply {
  id               Int            @id @default(autoincrement())
  trackedMessageId Int
  userId           BigInt
  status           String         @default("pending")
  respondedAt      DateTime?
  trackedMessage   TrackedMessage @relation(fields: [trackedMessageId], references: [id])
  user             User           @relation(fields: [userId], references: [telegramId])

  @@index([userId, status])
  @@index([trackedMessageId])
}

model Candidate {
  id                      String          @id @default(cuid())
  userId                  String          @unique
  fullName                String?
  phone                   String?
  birthDate               DateTime?
  gender                  String?
  city                    String?
  source                  String?
  clickSource             String? // Технічне джерело з deep-link (start=source_...)
  status                  CandidateStatus @default(SCREENING)
  locationId              String?
  interviewSlotId         String?         @unique
  discoverySlotId         String?         @unique
  trainingSlotId          String?         @unique
  googleMeetLink          String?
  trainingMeetLink        String?
  currentStep             FunnelStep      @default(INITIAL_TEST)
  isWaitlisted            Boolean         @default(false)
  isOtherCity             Boolean         @default(false)
  isHRLocked              Boolean         @default(false)
  isMentorLocked          Boolean         @default(true)
  interviewCompletedAt    DateTime?
  discoveryCompletedAt    DateTime?
  trainingCompletedAt     DateTime?
  hrDecision              String?
  notificationSent        Boolean         @default(false)
  stagingNotifiedAt       DateTime?
  interviewInvitedAt      DateTime?
  interviewWaitlistReason String?
  // Момент, когда кандидатка нажала "start_scheduling" и активных слотов не
  // нашлось вообще (не "не подошёл день" — тот случай в interviewWaitlistReason).
  // Зеркалится в вебапп полем noSlotsAt; очищается при успешной броне слота.
  noSlotsAt               DateTime?
  materialsSent           Boolean         @default(false)
  materialsSentAt         DateTime?
  candidateDecision       String?
  lossStage               String?
  lossReason              String?
  lostAt                  DateTime?
  hrScore                 Int?
  mentorScore             Int?
  hrComment               String?
  mentorComment           String?
  appearance              String?
  tattooPhotoId           String?
  hasUnreadMessage        Boolean         @default(false)
  lastSystemMessageId     Int?
  testPassed              Boolean?
  ndaConfirmedAt          DateTime?
  ndaSentAt               DateTime?
  ndaReminderSentAt       DateTime?
  /// Когда отправлено напоминание о брошенной анкете. Держит его однократным:
  /// вокер крутится каждые 5 минут, и временного окна для этого мало.
  screeningReminderSentAt DateTime?
  mentorReminderSent      Boolean         @default(false)
  mentorReminderSentAt    DateTime?
  mentorManualContactedAt DateTime?
  firstShiftDate          DateTime?
  firstShiftTime          String?
  firstShiftPartnerId     String?

  // Onboarding & Legal Data
  iban                String?
  passportNumber      String?
  passportIssuedAt    DateTime?
  passportIssuedBy    String?
  ipn                 String?
  registrationAddress String?
  email               String?
  instagram           String?
  bankCard            String?
  passportPhotoIds    String? // Comma-separated file IDs

  // Quiz results
  quizScore                Int?
  quizAnswers              String? // JSON string of answers
  statusChangedAt          DateTime? // When status last changed
  pipelineTouchedAt        DateTime                  @default(now()) // Any meaningful candidate pipeline action
  applications             Application[]
  interviewSlot            InterviewSlot?            @relation(fields: [interviewSlotId], references: [id])
  location                 Location?                 @relation(fields: [locationId], references: [id])
  discoverySlot            TrainingSlot?             @relation("CandidateDiscoverySlot", fields: [discoverySlotId], references: [id])
  trainingSlot             TrainingSlot?             @relation("CandidateTrainingSlot", fields: [trainingSlotId], references: [id])
  firstShiftPartner        StaffProfile?             @relation("CandidateFirstShift", fields: [firstShiftPartnerId], references: [id])
  user                     User                      @relation(fields: [userId], references: [id])
  messages                 Message[]
  lead                     Lead?
  firstShiftOnboardingCase FirstShiftOnboardingCase?

  @@index([status])
  @@index([userId])
  @@index([locationId])
  @@index([city])
}

model Lead {
  id               String        @id @default(cuid())
  externalId       String        @unique // ID з OLX/Instagram (UserID)
  platformThreadId String?       @unique // OLX Thread ID
  platformAdId     String? // OLX Ad ID (Optional context)
  platform         LeadPlatform
  name             String?
  phone            String?
  lastMessage      String?
  status           LeadStatus    @default(NEW)
  topicId          Int? // ID топіка в Telegram
  candidateId      String?       @unique // Зв'язок, якщо став кандидатом
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  messages         LeadMessage[]

  candidate Candidate? @relation(fields: [candidateId], references: [id])

  @@index([externalId])
  @@index([status])
}

model LeadMessage {
  id        String   @id @default(cuid())
  leadId    String
  direction String // "IN" або "OUT"
  text      String?
  mediaUrl  String?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

enum LeadPlatform {
  INSTAGRAM
  OLX
  WORK_UA
  MANUAL
}

enum LeadStatus {
  NEW
  INVITED
  IN_PROGRESS
  CONVERTED
  CLOSED
}

enum TaskCompletionMode {
  QUICK
  PROOF_REQUIRED
}

enum TaskProofSubmissionStatus {
  DRAFT
  SUBMITTED
}

enum TaskProofItemType {
  TEXT
  PHOTO
  VIDEO
  DOCUMENT
  VOICE
  AUDIO
  ANIMATION
}

model Location {
  id                     String               @id @default(cuid())
  awsPublicId            String?              @unique
  canonicalCode          String?              @unique
  name                   String
  /** Canonical branch, e.g. "Бабурка". Disambiguates same-named venues. */
  branch                 String?
  city                   String
  address                String?
  npRef                  String? // Nova Poshta Department/Postomat Ref
  npAddressRef           String? // Nova Poshta Address Ref (for courier delivery)
  neededCount            Int                  @default(0)
  summaryTemplate        String?
  isHidden               Boolean              @default(false)
  isHiddenFromCandidates Boolean              @default(false)
  googleMapsLink         String?
  salary                 String?
  schedule               String?
  legacyName             String?
  sheet                  String?
  terminalId             String?
  searchId               Int?
  hasAcquiring           Boolean              @default(false)
  cashInEnvelope         Boolean              @default(false)
  fopId                  String?
  telegramChatId         BigInt?
  candidates             Candidate[]
  staff                  StaffProfile[]
  shifts                 WorkShift[]
  replacementRequests    ReplacementRequest[]
  parcels                Parcel[]
  openingHours           LocationOpeningHours[]
}

/**
 * Mirror of the canonical `location_opening_hours` table. Replaces the hand-seeded
 * free-text `Location.schedule`, which nothing kept in sync with the real hours.
 */
model LocationOpeningHours {
  id         String   @id @default(cuid())
  locationId String
  /** 1 = Monday … 7 = Sunday, ISO-8601. */
  dayOfWeek  Int
  /** Local wall-clock `HH:MM`; `closes` < `opens` means the shift runs past midnight. */
  opens      String
  closes     String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek])
  @@index([locationId])
}

model Application {
  id          String    @id @default(cuid())
  candidateId String
  stage       String
  data        String?
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id])
}

model HRProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model MentorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model InterviewSession {
  id        String          @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  createdAt DateTime        @default(now())
  slots     InterviewSlot[]
}

model InterviewSlot {
  id                 String           @id @default(cuid())
  sessionId          String
  startTime          DateTime
  endTime            DateTime
  isBooked           Boolean          @default(false)
  googleEventId      String?
  reminded6h         Boolean          @default(false)
  reminded10m        Boolean          @default(false)
  reminded2mHR       Boolean          @default(false)
  remindedCompletion Boolean          @default(false)
  candidateId        String?
  lastReminderMsgId  Int?
  // Ссылка на канонический слот вебаппа (фаза 2b): при включённом
  // AWS_RECRUITING_SLOTS_ENABLED бронь идёт в вебапп, а эта строка —
  // write-through-зеркало для напоминаний и календаря HR. NULL — слот
  // локальный, создан по-старому.
  webSlotPublicId    String?          @unique
  candidate          Candidate?
  interviewSession   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([isBooked, startTime])
  @@index([startTime])
}

model TrainingSession {
  id        String         @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  createdAt DateTime       @default(now())
  slots     TrainingSlot[]
}

model TrainingSlot {
  id                 String          @id @default(cuid())
  sessionId          String
  startTime          DateTime
  endTime            DateTime
  isBooked           Boolean         @default(false)
  googleEventId      String?
  reminded6h         Boolean         @default(false)
  reminded10m        Boolean         @default(false)
  reminded5mMentor   Boolean         @default(false)
  remindedCompletion Boolean         @default(false)
  candidateId        String?
  lastReminderMsgId  Int?
  candidate          Candidate?      @relation("CandidateTrainingSlot")
  candidateDiscovery Candidate?      @relation("CandidateDiscoverySlot")
  trainingSession    TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([startTime])
  @@index([sessionId])
}

model Message {
  id          String    @id @default(cuid())
  sender      String
  scope       String?   @default("HR") // "HR" or "MENTOR"
  content     String?
  photoId     String?
  createdAt   DateTime  @default(now())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
}

model Session {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model StaffProfile {
  id                   String                @id @default(cuid())
  awsEmployeePublicId  String?               @unique
  userId               String                @unique
  fullName             String
  surnameNameDot       String?
  phone                String?
  npPhone              String? // Phone number for Nova Poshta authorization
  birthDate            DateTime?
  onboardingDate       DateTime?             @default(now())
  fopName              String?
  salaryBalance        Float                 @default(0)
  isActive             Boolean               @default(true)
  deactivatedAt        DateTime?
  deactivatedBy        String?
  deactivatedSource    String?
  deactivatedReason    String?
  isWelcomeSent        Boolean               @default(false)
  locationId           String?
  lastTaskDigestAt     DateTime?
  location             Location?             @relation(fields: [locationId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id])
  tasks                Task[]
  taskProofSubmissions TaskProofSubmission[]
  shifts               WorkShift[]
  replacementRequests  ReplacementRequest[]  @relation("ReplacementRequester")
  acceptedReplacements ReplacementRequest[]  @relation("ReplacementAcceptor")
  replacementResponses ReplacementResponse[]
  firstShiftCandidates Candidate[]           @relation("CandidateFirstShift")
  parcels              Parcel[]              @relation("ResponsibleStaff")

  @@index([isActive])
  @@index([locationId, isActive])
}

model Parcel {
  id         String       @id @default(cuid())
  ttn        String       @unique
  status     ParcelStatus @default(EXPECTED)
  locationId String?
  location   Location?    @relation(fields: [locationId], references: [id])

  npAddressRef           String? // NP RecipientAddress Ref (for auto-mapping)
  npCity                 String? // City from NP (for fallback mapping)
  npAddress              String? // Full address description from NP
  recipientPhone         String? // For authorization/proxies
  npTrusteeOrderRef      String? // NP change request Ref for recipient updates
  npTrusteeOrderNumber   String? // NP change request Number for recipient updates
  npTrusteeError         String? // Last NP trustee creation error
  npTrusteeLastAttemptAt DateTime? // Last time trustee creation was attempted
  description            String?
  deliveryType           String // "Warehouse", "Postomat", "Address"

  scheduledDate DateTime? // Expected delivery date
  arrivedAt     DateTime?

  responsibleStaffId String?
  responsibleStaff   StaffProfile? @relation("ResponsibleStaff", fields: [responsibleStaffId], references: [id])

  acceptedAt DateTime? // When responsibleStaffId was last assigned (for handoff guard)

  rejectionCount  Int       @default(0)
  lastRejectionAt DateTime?

  contentPhotoIds        String[]  @default([]) // Telegram file_ids
  photoReminderSentAt    DateTime? // When the "please upload photo" reminder was sent
  shiftEndReminderSentAt DateTime? // When the shift-end pickup reminder was sent
  staleAlertSentAt       DateTime? // When the "parcel delayed" support alert was sent

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([locationId])
}

enum ParcelStatus {
  EXPECTED
  IN_TRANSIT
  ARRIVED
  PICKUP_IN_PROGRESS
  DELIVERED
  VERIFYING
  COMPLETED
  CANCELLED
}

model WorkShift {
  id                        String               @id @default(cuid())
  awsScheduledShiftPublicId String?              @unique
  staffId                   String
  locationId                String
  date                      DateTime
  startTime                 DateTime?
  endTime                   DateTime?
  location                  Location             @relation(fields: [locationId], references: [id])
  staff                     StaffProfile         @relation(fields: [staffId], references: [id])
  replacementRequests       ReplacementRequest[]

  @@index([date])
}

enum ReplacementRequestStatus {
  ACTIVE
  FOUND
  CANCELLED
  EXPIRED
  FAILED
  CLOSED_BY_SCHEDULE_SYNC
}

enum ReplacementSearchWave {
  SAME_LOCATION_AVAILABLE
  SAME_LOCATION_LIMITED
  SAME_CITY_AVAILABLE
  SAME_CITY_LIMITED
  URGENT_ALL
}

enum ReplacementResponseStatus {
  SENT
  ACCEPTED
  DECLINED
  INACTIVE
  DELIVERY_FAILED
}

enum ReplacementAvailabilityKind {
  AVAILABLE
  LIMITED
}

model ReplacementRequest {
  id                 String                   @id @default(cuid())
  workShiftId        String?
  requesterStaffId   String?
  replacementStaffId String?
  locationId         String
  city               String
  shiftDate          DateTime
  shiftStartTime     DateTime?
  shiftEndTime       DateTime?
  status             ReplacementRequestStatus @default(ACTIVE)
  currentWave        ReplacementSearchWave?
  nextWaveAt         DateTime?
  completedAt        DateTime?
  closedReason       String?
  adminNotifiedAt    DateTime?
  awsReplacementPublicId String?              @unique
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  workShift   WorkShift?            @relation(fields: [workShiftId], references: [id], onDelete: SetNull)
  requester   StaffProfile?         @relation("ReplacementRequester", fields: [requesterStaffId], references: [id], onDelete: Cascade)
  replacement StaffProfile?         @relation("ReplacementAcceptor", fields: [replacementStaffId], references: [id])
  location    Location              @relation(fields: [locationId], references: [id])
  responses   ReplacementResponse[]

  @@index([status, nextWaveAt])
  @@index([requesterStaffId, status])
}

model ReplacementResponse {
  id               String                      @id @default(cuid())
  requestId        String
  staffId          String
  wave             ReplacementSearchWave
  availabilityKind ReplacementAvailabilityKind
  status           ReplacementResponseStatus   @default(SENT)
  chatId           BigInt?
  messageId        Int?
  sentAt           DateTime                    @default(now())
  respondedAt      DateTime?
  deliveryError    String?

  request ReplacementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  staff   StaffProfile       @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([requestId, staffId])
  @@index([requestId, status])
  @@index([staffId])
}

model Task {
  id                     String               @id @default(cuid())
  staffId                String
  taskText               String
  workDate               DateTime?
  deadlineTime           String?
  completionMode         TaskCompletionMode   @default(QUICK)
  isCompleted            Boolean              @default(false)
  completedAt            DateTime?
  city                   String?
  locationName           String?
  fileId                 String?
  createdById            String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  reminderSentAt         DateTime?
  overdueAdminNotifiedAt DateTime?
  staff                  StaffProfile         @relation(fields: [staffId], references: [id])
  proofSubmission        TaskProofSubmission?

  @@index([workDate])
  @@index([isCompleted])
  @@index([staffId])
}

model TaskProofSubmission {
  id                   String                       @id @default(cuid())
  taskId               String                       @unique
  staffId              String
  status               TaskProofSubmissionStatus    @default(DRAFT)
  supportChatId        BigInt?
  supportTopicId       Int?
  supportTopicStatus   TaskProofSupportTopicStatus?
  supportTopicOpenedAt DateTime?
  supportTopicClosedAt DateTime?
  supportLastMessageAt DateTime?
  submittedAt          DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  lastItemAt           DateTime?
  task                 Task                         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  staff                StaffProfile                 @relation(fields: [staffId], references: [id], onDelete: Cascade)
  items                TaskProofItem[]

  @@index([staffId])
  @@index([status])
  @@index([supportChatId, supportTopicId])
  @@index([supportTopicStatus, supportLastMessageAt])
}

model TaskProofItem {
  id             String              @id @default(cuid())
  submissionId   String
  type           TaskProofItemType
  text           String?
  telegramFileId String?
  caption        String?
  createdAt      DateTime            @default(now())
  submission     TaskProofSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
}

model SupportTicket {
  id              Int          @id @default(autoincrement())
  userId          String
  status          TicketStatus @default(OPEN)
  isUrgent        Boolean      @default(false)
  issueText       String
  topicId         Int?
  assignedAdminId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation("UserTickets", fields: [userId], references: [id])
  assignedAdmin   User?        @relation("AssignedTickets", fields: [assignedAdminId], references: [id])

  @@index([userId, status])
  @@index([status])
  @@index([topicId])
}

model FinanceLog {
  id           String         @id @default(cuid())
  type         FinanceLogType
  amount       Float
  category     String?
  comment      String?
  fopAccount   String?
  locationName String?
  isSynced     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  adminId      String?
}

model OutgoingTopic {
  id        Int      @id @default(autoincrement())
  chatId    BigInt
  topicId   Int
  staffName String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isClosed, updatedAt])
  @@index([userId])
}

model FirstShiftOnboardingCase {
  id                     String                     @id @default(cuid())
  candidateId            String                     @unique
  status                 FirstShiftOnboardingStatus @default(OPEN)
  chatId                 BigInt?
  topicId                Int?
  statusMessageId        Int?
  entryMessageLeaseUntil DateTime?
  entryMessageSentAt     DateTime?
  currentStepKey         String?
  startedAt              DateTime?
  completedAt            DateTime?
  failureReason          String?
  mentorFinalNote        String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  candidate Candidate                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  steps     FirstShiftOnboardingStep[]

  @@index([status, updatedAt])
  @@index([topicId])
}

model FirstShiftOnboardingStep {
  id                     String                         @id @default(cuid())
  caseId                 String
  key                    String
  block                  String
  title                  String
  prompt                 String
  order                  Int
  inputType              FirstShiftOnboardingInputType
  status                 FirstShiftOnboardingStepStatus @default(LOCKED)
  requiresMentorApproval Boolean                        @default(true)
  submittedText          String?
  photoIds               String?
  mentorComment          String?
  submittedAt            DateTime?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  completedAt            DateTime?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  case FirstShiftOnboardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, key])
  @@index([caseId, order])
  @@index([status])
}

model MagnetCountRun {
  id                  String                @id @default(cuid())
  adminUserId         String
  photoFileId         String
  estimatedTotal      Int
  finalTotal          Int?
  confidence          MagnetCountConfidence
  stackCounts         String?
  notes               String?
  model               String?
  isManuallyCorrected Boolean               @default(false)
  finalizedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  adminUser           User                  @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([createdAt])
}

enum Role {
  CANDIDATE
  STAFF
  HR
  MENTOR
  ADMIN
}

enum AdminRole {
  SUPER_ADMIN
  CO_FOUNDER
  SUPPORT
  HR_LEAD
  MENTOR_LEAD
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum FirstShiftOnboardingStatus {
  OPEN
  IN_PROGRESS
  CLOSING
  PENDING_FINAL
  PASSED
  FAILED
  CANCELLED
}

enum FirstShiftOnboardingStepStatus {
  LOCKED
  ACTIVE
  SUBMITTED
  APPROVED
  REJECTED
  SKIPPED
}

enum FirstShiftOnboardingInputType {
  BUTTON
  PHOTO
  MULTIPLE_PHOTOS
  SCREENSHOT
  TEXT
  LINK
  MENTOR_OBSERVED
}

enum TaskProofSupportTopicStatus {
  OPEN
  WAITING_FOR_STAFF
  WAITING_FOR_SUPPORT
  CLOSED
}

enum MagnetCountConfidence {
  high
  medium
  low
}

enum FinanceLogType {
  INCOME
  EXPENSE
}

enum CandidateStatus {
  SCREENING
  WAITLIST
  WAITLIST_HR
  WAITLIST_MENTOR
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  DECISION_PENDING
  ACCEPTED
  REJECTED
  HIRED
  MANUAL_REVIEW
  DISCOVERY_SCHEDULED
  DISCOVERY_COMPLETED
  TRAINING_SCHEDULED
  TRAINING_COMPLETED
  OFFLINE_STAGING
  AWAITING_FIRST_SHIFT
  BLOCKER
  MENTOR_MANUAL

  // Refactored Final Step Pipeline
  NDA
  KNOWLEDGE_TEST
  STAGING_SETUP
  STAGING_ACTIVE
  READY_FOR_HIRE
}

enum FunnelStep {
  INITIAL_TEST
  INTERVIEW
  TRAINING
  FIRST_SHIFT
}

model UserTimelineEvent {
  id        Int      @id @default(autoincrement())
  userId    String
  type      String // MESSAGE | SYSTEM_EVENT | STATUS_CHANGE
  author    String // "USER", "ADMIN", "SYSTEM"
  text      String? // Текст повідомлення або опис події
  metadata  String? // JSON з деталями
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model ChatLog {
  id          Int      @id @default(autoincrement())
  telegramId  BigInt
  userId      String?
  direction   String // "IN" = от пользователя, "OUT" = від бота
  contentType String // "text", "callback", "photo", "video", "document", "sticker", "contact"
  text        String?
  mediaFileId String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([telegramId])
  @@index([userId])
  @@index([createdAt])
}

model SystemState {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExternalToken {
  id           String    @id @default(cuid())
  service      String    @unique // e.g. "OLX", "INSTAGRAM"
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  updatedAt    DateTime  @updatedAt
}

/// Чаты, в которых бот состоит. Наполняется событием `my_chat_member` и сверкой
/// при старте — вручную этот список не ведётся.
///
/// Ручной список уже разошёлся с реальностью: из двадцати локаций одна осталась
/// без `telegramChatId`, то есть невидима для отзыва доступов. Наблюдаемое
/// состояние устареть не может, записанное однажды — может.
model KnownChat {
  /// Идентификатор чата в Telegram, а не суррогатный ключ: он уникален, и
  /// повторное добавление бота в тот же чат должно обновлять строку.
  id      BigInt  @id
  title   String?
  type    String

  addedAt DateTime  @default(now())
  /// Проставляется, когда бота удалили или разжаловали. Строка НЕ удаляется:
  /// след того, что чат существовал и людей оттуда выгоняли, нужен аудиту.
  lostAt  DateTime?

  @@index([lostAt])
}
